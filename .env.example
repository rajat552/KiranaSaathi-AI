# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (Leave empty to use built-in MongoDB Memory Server for demo/tests)
MONGODB_URI=
USE_MEMORY_DB=true

# Security & Authentication
JWT_ACCESS_SECRET=kiranasaathi_super_secret_jwt_access_key_2026_demo
JWT_REFRESH_SECRET=kiranasaathi_super_secret_jwt_refresh_key_2026_demo
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=*

# AI Provider (Optional: GEMINI_API_KEY or LYZR_API_KEY)
GEMINI_API_KEY=
LYZR_API_KEY=
